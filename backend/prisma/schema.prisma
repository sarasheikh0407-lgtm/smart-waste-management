generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(CITIZEN)
  createdAt    DateTime @default(now())
  reports      WasteReport[]

  @@index([createdAt])
}

enum UserRole {
  CITIZEN
  OPERATOR
  ADMIN
}

model Bin {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  area      String
  fillLevel Int       @default(0)
  status    BinStatus @default(NORMAL)
  latitude  Float
  longitude Float
  lastSeen  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, fillLevel])
  @@index([area])
}

enum BinStatus {
  NORMAL
  WARNING
  OVERFLOWING
  OFFLINE
}

model WasteReport {
  id          String       @id @default(cuid())
  category    String
  description String
  area        String
  latitude    Float?
  longitude   Float?
  status      ReportStatus @default(OPEN)
  reporterId  String?
  reporter    User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([area])
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
